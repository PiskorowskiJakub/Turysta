# Skopiuj na serwerze do .env i uzupelnij. Plik .env nie trafia do repozytorium.
# Dzieki tej zmiennej zwykle "docker compose ..." dziala na pliku produkcyjnym (tez skrypty backup/restore).
COMPOSE_FILE=docker-compose.prod.yml

# --- Domena i istniejacy Traefik (wartosci z konfiguracji Traefika drugiej strony) ---
GAME_DOMAIN=dwadukaty.pl
TRAEFIK_NETWORK=nazwa_sieci_traefika
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=nazwa_resolvera_letsencrypt

# --- Baza (ustaw dlugie, unikalne hasla) ---
DB_NAME=turysta
DB_USER=turysta
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Aplikacja ---
APP_ENV=prod
APP_URL=https://dwadukaty.pl

# --- Poczta (prawdziwy SMTP; bez tego rejestracja nie wysle linku potwierdzajacego) ---
MAIL_HOST=smtp.twojdostawca.pl
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@dwadukaty.pl

# --- Kopie zapasowe (opcjonalnie) ---
BACKUP_DIR=./backups
# RCLONE_REMOTE=nazwa:sciezka
