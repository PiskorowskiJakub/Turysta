@use 'base' as *;

* { box-sizing: border-box; }

body {
  margin: 0;
  background-image: $base-background-image;
  font-family: $font-stack;
  background-repeat: no-repeat;
  background-position: center center;
  background-attachment: fixed;
  background-size: cover;
  color: $fifth-color;
}

#root {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

nav {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  padding: 8px 12px;
  background: $fourth-color;

  a, .nav-button {
    color: $first-color;
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 6px;
    background: none;
    border: 0;
    font: inherit;
    cursor: pointer;
  }
  a:hover, .nav-button:hover { background: $fifth-color; }
  a.nav-active { background: $third-color; color: $fifth-color; }
}

.Page {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 16px;
  gap: 16px;

  header, section { width: 100%; max-width: 900px; }
}

.game-header {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 24px;
  align-items: baseline;
  padding: 10px 16px;
  background: rgba($first-color, 0.92);
  border-radius: 8px;
}

footer {
  background-image: $footer-background-image;
  background-repeat: no-repeat;
  background-position: bottom center;
  min-height: 120px;
  padding: 0 16px;
  color: $first-color;
}

.card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 20px 24px;
  background: rgba($first-color, 0.95);
  border-radius: 10px;
  max-width: 520px;
  margin: 0 auto;

  h1, h2 { margin: 0; }
  h2 { font-size: 1.1rem; margin-top: 8px; }
}

.field {
  display: flex;
  flex-direction: column;
  gap: 4px;

  label { font-weight: 600; font-size: 0.9rem; }
  input {
    padding: 8px 10px;
    border: 1px solid $third-color;
    border-radius: 6px;
    font: inherit;
  }
  input[aria-invalid='true'] { border-color: $error-color; }
}

.field-error, .form-error { color: $error-color; margin: 0; font-size: 0.9rem; }
.form-success { color: $fourth-color; font-weight: 600; margin: 0; }
.form-notice { background: $second-color; padding: 8px 12px; border-radius: 6px; margin: 0; }
.muted { color: $fourth-color; opacity: 0.8; margin: 0; }

.button {
  display: inline-block;
  padding: 10px 18px;
  border: 0;
  border-radius: 8px;
  background: $fourth-color;
  color: $first-color;
  font: inherit;
  font-weight: 600;
  text-decoration: none;
  text-align: center;
  cursor: pointer;

  &:hover { background: $fifth-color; }
  &:disabled { opacity: 0.5; cursor: not-allowed; }
  &.secondary { background: $second-color; color: $fifth-color; }
}

.actions { display: flex; gap: 8px; flex-wrap: wrap; margin: 0; }

.choices { display: flex; flex-wrap: wrap; gap: 8px; }
.choice {
  padding: 10px 14px;
  border: 2px solid $second-color;
  border-radius: 8px;
  background: #fff;
  font: inherit;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;

  &.selected { border-color: $fourth-color; background: $second-color; }
  &.avatar img { width: 72px; height: 72px; object-fit: cover; border-radius: 50%; }
}

.stats {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;

  li { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid $second-color; }
}

.card.wide { max-width: 760px; }
.button.small { padding: 6px 12px; font-size: 0.9rem; }

.progress {
  height: 12px;
  background: $second-color;
  border-radius: 6px;
  overflow: hidden;

  .progress-fill { height: 100%; background: $third-color; transition: width 1s linear; }
}

.queue, .skills, .notifications { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }

.queue-item {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 10px 12px;
  background: #fff;
  border-radius: 8px;

  .queue-head { display: flex; justify-content: space-between; gap: 8px; }
  .button { align-self: flex-start; }
}

.skill-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 0;
  border-bottom: 1px solid $second-color;
}

.active-job { display: flex; flex-direction: column; gap: 8px; padding: 12px; background: #fff; border-radius: 8px; }

.notifications li { padding: 6px 10px; border-radius: 6px; background: #fff; }
.notifications li.unread { border-left: 4px solid $third-color; font-weight: 600; }
